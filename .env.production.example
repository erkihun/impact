APP_NAME="Impact Consulting"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.example.org
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_AFTER_COMMIT=true
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
SESSION_ABSOLUTE_LIFETIME=480

REDIS_CLIENT=predis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

FILESYSTEM_DISK=s3
QUARANTINE_DISK=s3
PUBLIC_MEDIA_DISK=s3
PRIVATE_MEDIA_DISK=s3
ENGAGEMENT_ATTACHMENT_MAX_FILES=5
ENGAGEMENT_ATTACHMENT_MAX_KILOBYTES=20480
FILESYSTEM_THROW=true
FILESYSTEM_REPORT=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.org
MAIL_FROM_NAME="${APP_NAME}"

SCOUT_DRIVER=database
MALWARE_SCANNING_ENABLED=true
CLAMAV_BINARY=clamdscan
MALWARE_SCAN_TIMEOUT_SECONDS=120

IMPACT_DEFAULT_LOCALE=en
PRIVACY_POLICY_VERSION=
SEARCH_QUERY_LOG_DAYS=90
ANALYTICS_OUTBOX_DAYS=30
NEWSLETTER_CONFIRMATION_TTL_HOURS=48
ENGAGEMENT_RETENTION_DAYS=
APPLICATION_RETENTION_DAYS=
EVENT_REGISTRATION_RETENTION_DAYS=
RETENTION_POLICY_VERSION=
RETENTION_EXECUTION_ENABLED=false
RETENTION_APPROVED_BY=
WORKFLOW_PREVENT_SELF_APPROVAL=true

TRUSTED_HOSTS=example.org,www.example.org
TRUSTED_PROXIES=

DEVELOPMENT_ADMIN_EMAIL=
DEVELOPMENT_ADMIN_PASSWORD=
VITE_APP_NAME="${APP_NAME}"
