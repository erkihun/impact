APP_NAME="Impact Consulting"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=impact
DB_USERNAME=impact
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ABSOLUTE_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUARANTINE_DISK=local
PUBLIC_MEDIA_DISK=public
PRIVATE_MEDIA_DISK=local
ENGAGEMENT_ATTACHMENT_MAX_FILES=5
ENGAGEMENT_ATTACHMENT_MAX_KILOBYTES=20480
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@impact.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SCOUT_DRIVER=database
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

IMPACT_DEFAULT_LOCALE=en
PRIVACY_POLICY_VERSION=2026-07-26
SEARCH_QUERY_LOG_DAYS=90
ANALYTICS_OUTBOX_DAYS=30
ENGAGEMENT_RETENTION_DAYS=730
APPLICATION_RETENTION_DAYS=730
EVENT_REGISTRATION_RETENTION_DAYS=365
WORKFLOW_PREVENT_SELF_APPROVAL=true
QUARANTINE_DISK=local
MALWARE_SCANNING_ENABLED=false
CLAMAV_BINARY=clamdscan
MALWARE_SCAN_TIMEOUT_SECONDS=120
FILESYSTEM_THROW=true
FILESYSTEM_REPORT=true
NEWSLETTER_CONFIRMATION_TTL_HOURS=48
RETENTION_POLICY_VERSION=2026-07-26
RETENTION_EXECUTION_ENABLED=false
RETENTION_APPROVED_BY=
TRUSTED_HOSTS=
TRUSTED_PROXIES=

DEVELOPMENT_ADMIN_EMAIL=impact@local.com
DEVELOPMENT_ADMIN_PASSWORD=Impact2018

VITE_APP_NAME="${APP_NAME}"
